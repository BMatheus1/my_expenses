APP_NAME="My Expenses API"
APP_ENV="development"
APP_DEBUG=false

API_PREFIX="/api"
FRONTEND_URL="http://127.0.0.1:3000"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_expenses"

LEGACY_JSON_FILE="data/expenses.json"
LEGACY_IMPORT_EMAIL=""

SECRET_KEY="CHANGE_ME_TO_A_RANDOM_SECRET_WITH_32_CHARS_MINIMUM"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME="my_expenses_refresh_token"
REFRESH_COOKIE_PATH="/api/auth"
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE="lax"

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

SMTP_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@myexpenses.local"
SMTP_FROM_NAME="My Expenses"
SMTP_USE_TLS=true

GOOGLE_CLIENT_ID=""

MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_API_BASE_URL="https://api.mercadopago.com"
SUBSCRIPTION_MONTHLY_PRICE=8.99
SUBSCRIPTION_TRIAL_DAYS=30
SUBSCRIPTION_CURRENCY_ID="BRL"

CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_HEADERS="Authorization,Content-Type"

RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
WRITE_RATE_LIMIT_REQUESTS=120
WRITE_RATE_LIMIT_WINDOW_SECONDS=60

MAX_REQUEST_BODY_BYTES=1000000
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000


EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

RESEND_API_KEY=""

SMTP_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@myexpensesfinance.com"
SMTP_FROM_NAME="My Expenses"
SMTP_USE_TLS=true
