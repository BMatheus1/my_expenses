@"
# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
backend/.venv/

# Backend local data
backend/data/*.db
backend/data/*.db-journal
backend/data/*.sqlite
backend/data/*.sqlite3
backend/data/expenses.json
!backend/data/.gitkeep

# Environment files
.env
.env.*
!.env.example

backend/.env
backend/.env.*
!backend/.env.example

frontend/.env
frontend/.env.*
frontend/.env.local
!frontend/.env.local.example

# Node / Next
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
"@ | Set-Content -Encoding UTF8 .gitignore